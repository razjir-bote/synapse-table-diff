{
  "name": "synapse-table-diff",
  "displayName": "Table Diff",
  "description": "Compare SQL Server and Azure Synapse tables",
  "version": "0.6.0",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "tableDiff.compare",
        "title": "Table Diff: Compare Tables…",
        "icon": "$(diff)"
      },
      {
        "command": "tableDiff.compareSchemas",
        "title": "Compare Schemas…",
        "category": "Table Diff",
        "icon": "$(list-tree)"
      },
      {
        "command": "tableDiff.addConnection",
        "title": "Table Diff: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "tableDiff.removeConnection",
        "title": "Table Diff: Remove Connection"
      },
      {
        "command": "tableDiff.rerunRecent",
        "title": "Table Diff: Re-run Recent…"
      },
      {
        "command": "tableDiff.removeConnectionItem",
        "title": "Remove Connection",
        "icon": "$(trash)"
      },
      {
        "command": "tableDiff.openRecent",
        "title": "Open in Setup Form",
        "icon": "$(edit)"
      },
      {
        "command": "tableDiff.runRecent",
        "title": "Run Again",
        "icon": "$(play)"
      }
    ],
    "configuration": {
      "title": "Table Diff",
      "properties": {
        "tableDiff.pairLimit": {
          "type": "number",
          "default": 2000000,
          "minimum": 1000,
          "description": "Maximum number of row pairs compared."
        },
        "tableDiff.detailLimit": {
          "type": "number",
          "default": 100000,
          "minimum": 1,
          "maximum": 1000000,
          "description": "Maximum number of detail rows returned."
        },
        "tableDiff.inListCap": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "maximum": 20000,
          "description": "Maximum number of bucket ids per narrowing or detail filter."
        },
        "tableDiff.queryTimeoutSeconds": {
          "type": "number",
          "default": 3600,
          "minimum": 30,
          "description": "Query timeout in seconds."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tableDiff",
          "title": "Table Diff",
          "icon": "media/table-diff.svg"
        }
      ]
    },
    "views": {
      "tableDiff": [
        {
          "id": "tableDiff.connections",
          "name": "Connections"
        },
        {
          "id": "tableDiff.recent",
          "name": "Recent Comparisons"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tableDiff.connections",
        "contents": "No connections yet. Add a SQL Server or Synapse connection to get started.\n[Add Connection](command:tableDiff.addConnection)\n[New Comparison](command:tableDiff.compare)\n[Compare Schemas](command:tableDiff.compareSchemas)"
      },
      {
        "view": "tableDiff.recent",
        "contents": "No comparisons yet.\n[New Comparison](command:tableDiff.compare)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tableDiff.compare",
          "when": "view == tableDiff.connections",
          "group": "navigation@1"
        },
        {
          "command": "tableDiff.addConnection",
          "when": "view == tableDiff.connections",
          "group": "navigation@2"
        },
        {
          "command": "tableDiff.compareSchemas",
          "when": "view == tableDiff.connections",
          "group": "navigation@3"
        },
        {
          "command": "tableDiff.compare",
          "when": "view == tableDiff.recent",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "tableDiff.removeConnectionItem",
          "when": "view == tableDiff.connections && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "tableDiff.removeConnectionItem",
          "when": "view == tableDiff.connections && viewItem == connection",
          "group": "1_manage"
        },
        {
          "command": "tableDiff.runRecent",
          "when": "view == tableDiff.recent && viewItem == recent",
          "group": "inline"
        },
        {
          "command": "tableDiff.runRecent",
          "when": "view == tableDiff.recent && viewItem == recent",
          "group": "1_run@1"
        },
        {
          "command": "tableDiff.openRecent",
          "when": "view == tableDiff.recent && viewItem == recent",
          "group": "1_run@2"
        }
      ],
      "commandPalette": [
        {
          "command": "tableDiff.removeConnectionItem",
          "when": "false"
        },
        {
          "command": "tableDiff.openRecent",
          "when": "false"
        },
        {
          "command": "tableDiff.runRecent",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --allow-missing-repository --skip-license",
    "vscode:prepublish": "npm run typecheck && npm run compile"
  },
  "dependencies": {
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.1.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
